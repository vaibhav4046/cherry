{
  "name": "cherry",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Cherry — the user-owned apprenticeship, memory, mission and verification layer for AI agents.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "npm run typecheck && npm run lint && npm run test",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run test:runner",
    "verify:all": "npm run gates && npm run build && npm run test:e2e && npm run verify:pack && npm run audit:submission",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record:demo": "playwright test --config=playwright.demo.config.ts && node scripts/promote-demo-recording.mjs",
    "test:runner": "node --test runner/runner.test.mjs runner/mcp/bridge.test.mjs",
    "verify:pack": "node scripts/verify-release.mjs",
    "audit:submission": "node scripts/audit-submission.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@privy-io/react-auth": "3.38.0",
    "dexie": "^4.0.11",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.25.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    },
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.0"
    },
    "ws@^8.0.0": "8.21.3",
    "@huggingface/transformers": {
      "onnxruntime-node": {
        "adm-zip": "0.6.0"
      },
      "sharp": "0.35.4"
    }
  }
}
